<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>GameBoost</AssemblyName>
    <RootNamespace>GameBoost</RootNamespace>
    <Version>1.5.5</Version>
    <AssemblyVersion>1.5.5.0</AssemblyVersion>
    <FileVersion>1.5.5.0</FileVersion>
    <Company>Nous Logic</Company>
    <Product>GameBoost - Optimizacion de red para juegos online</Product>
    <Description>Medidor de ping en vivo, test de servidores, Modo Juego y optimizacion TCP/IP y DNS. Sin promesas falsas: no aumenta tu velocidad contratada ni acerca los servidores.</Description>
    <Copyright>Copyright (c) 2026 Nous Logic - nouslogic.xyz</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <!-- Publicacion recomendada: autocontenida, un solo archivo -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="logo.png" />
    <EmbeddedResource Include="logo.ico" />
    <None Include="logo-full.png" />
  </ItemGroup>
</Project>
